{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build 2048 (Make)",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Compile avec Makefile",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Build and Run",
            "type": "shell",
            "command": "make",
            "args": ["run"],
            "group": "test",
            "detail": "Compile et exécute le jeu",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Clean Project",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "detail": "Nettoie les fichiers compilés",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Copy DLLs",
            "type": "shell",
            "command": "make",
            "args": ["dll"],
            "detail": "Copie les DLLs SDL3 nécessaires",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Manual Compile (Debug)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "-I${workspaceFolder}/include",
                "-I/mingw64/include",
                "-I/mingw64/include/SDL3",
                "-L/mingw64/lib",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/Game.cpp",
                "${workspaceFolder}/src/Grid.cpp",
                "-o",
                "${workspaceFolder}/2048.exe",
                "-lSDL3",
                "-lSDL3_ttf",
                "-lSDL3_image",
                "-mconsole"
            ],
            "group": "build",
            "detail": "Compilation manuelle pour débogage",
            "problemMatcher": ["$gcc"]
        }
    ]
}